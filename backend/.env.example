# --- Database ---
DATABASE_URL=postgresql+psycopg2://ai_user:ai_password@localhost:5432/enterprise_ai
DATABASE_URL_ASYNC=postgresql+asyncpg://ai_user:ai_password@localhost:5432/enterprise_ai

# --- Auth ---
JWT_SECRET_KEY=change-this-to-a-random-64-char-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM Provider (swap-able) ---
LLM_PROVIDER=openai            # openai | local
OPENAI_API_KEY=sk-xxxxxxxx
OPENAI_CHAT_MODEL=gpt-5
LOCAL_LLM_BASE_URL=http://localhost:11434/v1   # e.g. Ollama / vLLM OpenAI-compatible endpoint

# --- Embeddings ---
EMBEDDING_PROVIDER=local        # local | openai
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- Storage ---
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=25

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
